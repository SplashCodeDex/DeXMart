{
  "name": "DeXMart-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "pnpm install",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev": "tsx watch --exclude 'openclaw/**/*' --exclude 'logs/**/*' --exclude 'sessions/**/*' --exclude 'temp/**/*' src/main.ts",
    "build:frontend": "pnpm --filter frontend build",
    "build:check": "NODE_OPTIONS='--max-old-space-size=4096' tsc",
    "build": "pnpm build:check && pnpm build:frontend",
    "lint:frontend": "pnpm --filter frontend lint",
    "test:frontend": "pnpm --filter frontend test",
    "test:all": "vitest run && pnpm --filter frontend test",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=4096' tsc --noEmit",
    "test:run": "vitest run",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "sync:report": "tsx scripts/automation/upstream-watcher.ts"
  },
